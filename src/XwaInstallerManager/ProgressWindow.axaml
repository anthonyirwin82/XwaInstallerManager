<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="360"
        x:Class="XwaInstallerManager.ProgressWindow"
        Width="560" Height="360"
        MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" Name="titleText" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1" Spacing="6" Margin="0,12,0,12">
            <ProgressBar Name="progressBar" IsIndeterminate="True" Height="6"/>
            <TextBlock Name="statusText" TextWrapping="Wrap" Opacity="0.8"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="4" Padding="8">
            <ScrollViewer Name="logScroller" VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock Name="logText" FontFamily="monospace" FontSize="12" TextWrapping="NoWrap"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Name="closeButton" Content="Close" MinWidth="88" IsVisible="False" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
