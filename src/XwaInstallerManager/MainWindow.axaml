<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XwaInstallerManager"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="600"
        x:Class="XwaInstallerManager.MainWindow"
        Title="Xwa Installer Manager"
        Width="1100" Height="600"
        MinWidth="800" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        UseLayoutRounding="True">
    <Window.DataContext>
        <local:ViewModel/>
    </Window.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <Button Command="{Binding ShowAboutBoxCommand}" ToolTip.Tip="About">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="Help" Width="18" Height="18"/>
                    <TextBlock Text="About" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding OpenSettingsWindowCommand}" ToolTip.Tip="Settings">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="Cog" Width="18" Height="18"/>
                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ExplorePackagesFolderCommand}" ToolTip.Tip="Open installer packages folder">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="FolderOpen" Width="18" Height="18"/>
                    <TextBlock Text="Open" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding Packages.AddPackageCommand}" ToolTip.Tip="Add url">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="Plus" Width="18" Height="18"/>
                    <TextBlock Text="Add url" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding Packages.SavePackagesCommand}" ToolTip.Tip="Save urls">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="ContentSave" Width="18" Height="18"/>
                    <TextBlock Text="Save urls" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding CheckForUpdatesCommand}" ToolTip.Tip="Check for updates">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="CheckAll" Width="18" Height="18"/>
                    <TextBlock Text="Check updates" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding LaunchXwaManagerCommand}" ToolTip.Tip="Launch manager">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="Play" Width="18" Height="18"/>
                    <TextBlock Text="Launch manager" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Packages grid -->
        <dg:DataGrid Grid.Row="1" Name="packagesGrid"
                     ItemsSource="{Binding Packages.Packages}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     CanUserReorderColumns="False"
                     CanUserSortColumns="True"
                     SelectionMode="Single"
                     GridLinesVisibility="Horizontal"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     Margin="8,0">
            <dg:DataGrid.Columns>
                <dg:DataGridTemplateColumn Header="Type" Width="90">
                    <dg:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <mi:MaterialIcon Kind="Brightness6" Width="16" Height="16" ToolTip.Tip="New"
                                                 IsVisible="{Binding PackageDateRecentVisibility}"/>
                                <mi:MaterialIcon Kind="FolderPlus" Width="16" Height="16" ToolTip.Tip="Full package"
                                                 IsVisible="{Binding IsFullPackageVisibility}"/>
                                <mi:MaterialIcon Kind="KeyboardReturn" Width="16" Height="16" ToolTip.Tip="Update package"
                                                 IsVisible="{Binding IsUpdatePackageVisibility}"/>
                                <mi:MaterialIcon Kind="Chip" Width="16" Height="16" ToolTip.Tip="Optional package"
                                                 IsVisible="{Binding IsAddOnPackageVisibility}"/>
                                <mi:MaterialIcon Kind="KeyboardReturn" Width="16" Height="16" ToolTip.Tip="Patch package"
                                                 IsVisible="{Binding IsPatchPackageVisibility}"/>
                            </StackPanel>
                        </DataTemplate>
                    </dg:DataGridTemplateColumn.CellTemplate>
                </dg:DataGridTemplateColumn>

                <dg:DataGridTemplateColumn Header="Name" Width="3.5*" SortMemberPath="PackageViewDefaultSort">
                    <dg:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PackageViewName}" TextWrapping="Wrap" Margin="3"
                                       FontWeight="{Binding PackageDateRecentFontWeight, Converter={StaticResource FontWeightConverter}}"/>
                        </DataTemplate>
                    </dg:DataGridTemplateColumn.CellTemplate>
                </dg:DataGridTemplateColumn>

                <dg:DataGridTextColumn Header="Version" Width="1*" Binding="{Binding PackageViewVersion}"/>

                <dg:DataGridTextColumn Header="Prerequisite" Width="2*" Binding="{Binding PackageViewPrerequisiteWithVersion}"/>

                <dg:DataGridTemplateColumn Header="Links" Width="1.2*">
                    <dg:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                <Button Padding="4" Command="{Binding LaunchUrlCommand}" ToolTip.Tip="{Binding Mod.Url, StringFormat='Open website {0}'}">
                                    <mi:MaterialIcon Kind="Web" Width="16" Height="16"/>
                                </Button>
                                <Button Padding="4" Command="{Binding LaunchChangeLogCommand}" ToolTip.Tip="{Binding ModVersion.ChangeLog, StringFormat='Open changelog {0}'}">
                                    <mi:MaterialIcon Kind="ClipboardText" Width="16" Height="16"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </dg:DataGridTemplateColumn.CellTemplate>
                </dg:DataGridTemplateColumn>

                <dg:DataGridTemplateColumn Header="Install" Width="80">
                    <dg:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button HorizontalAlignment="Center" Padding="4" Command="{Binding InstallCommand}" ToolTip.Tip="Install">
                                <mi:MaterialIcon Kind="Hammer" Width="16" Height="16"/>
                            </Button>
                        </DataTemplate>
                    </dg:DataGridTemplateColumn.CellTemplate>
                </dg:DataGridTemplateColumn>

                <dg:DataGridTemplateColumn Header="Date" Width="1.4*" SortMemberPath="PackageDate">
                    <dg:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PackageDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" TextWrapping="Wrap" Margin="2"
                                       FontWeight="{Binding PackageDateRecentFontWeight, Converter={StaticResource FontWeightConverter}}"/>
                        </DataTemplate>
                    </dg:DataGridTemplateColumn.CellTemplate>
                </dg:DataGridTemplateColumn>

                <dg:DataGridTemplateColumn Header="Download" Width="1.6*">
                    <dg:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                <Button Padding="4" IsVisible="{Binding DownloadButtonVisibility}" Command="{Binding DownloadCommand}" ToolTip.Tip="Download">
                                    <mi:MaterialIcon Kind="Download" Width="16" Height="16"/>
                                </Button>
                                <Button Padding="4" IsVisible="{Binding RedownloadButtonVisibility}" Command="{Binding DownloadCommand}" ToolTip.Tip="Redownload">
                                    <mi:MaterialIcon Kind="Restore" Width="16" Height="16"/>
                                </Button>
                                <Button Padding="4" IsVisible="{Binding DownloadCancelButtonVisibility}" Command="{Binding DownloadCancelCommand}" ToolTip.Tip="Cancel">
                                    <mi:MaterialIcon Kind="Close" Width="16" Height="16"/>
                                </Button>
                                <Button Padding="4" IsVisible="{Binding CanCheckHashVisibility}" Command="{Binding CheckFileHashCommand}" ToolTip.Tip="Check file hash">
                                    <mi:MaterialIcon Kind="CheckAll" Width="16" Height="16"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </dg:DataGridTemplateColumn.CellTemplate>
                </dg:DataGridTemplateColumn>

                <dg:DataGridTextColumn Header="Progress / Length" Width="2*" Binding="{Binding DownloadProgressMessage}"/>
            </dg:DataGrid.Columns>
        </dg:DataGrid>

        <!-- Status bar -->
        <WrapPanel Grid.Row="2" Margin="8" Orientation="Horizontal">
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,0">
                <mi:MaterialIcon Kind="Brightness6" Width="14" Height="14"/>
                <TextBlock Text="New" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="|" Margin="4,0"/>
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0">
                <mi:MaterialIcon Kind="FolderPlus" Width="14" Height="14"/>
                <TextBlock Text="Full" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="|" Margin="4,0"/>
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0">
                <mi:MaterialIcon Kind="KeyboardReturn" Width="14" Height="14"/>
                <TextBlock Text="Update" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="|" Margin="4,0"/>
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0">
                <mi:MaterialIcon Kind="Chip" Width="14" Height="14"/>
                <TextBlock Text="Optional" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="|" Margin="4,0"/>
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0">
                <mi:MaterialIcon Kind="Web" Width="14" Height="14"/>
                <TextBlock Text="Open website" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="|" Margin="4,0"/>
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0">
                <mi:MaterialIcon Kind="Download" Width="14" Height="14"/>
                <TextBlock Text="Download" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="|" Margin="4,0"/>
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0">
                <mi:MaterialIcon Kind="Hammer" Width="14" Height="14"/>
                <TextBlock Text="Install" VerticalAlignment="Center"/>
            </StackPanel>
        </WrapPanel>
    </Grid>
</Window>
